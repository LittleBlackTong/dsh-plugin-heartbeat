{
  "name": "dsh-plugin-heartbeat",
  "description": "Autonomic heartbeat for DeepSeek Harness: silent pulses diff the session's todos / team board / goal, then speaks only on a signal (report / ask / escalate) with dedupe, quiet hours and a daily budget; carries a heart mark in the settings sidebar.",
  "version": "0.6.0",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "types": "types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**",
    "types/**",
    "cordis.patch.yml",
    "CHANGELOG.md",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "scripts": {
    "test": "node --test"
  },
  "engines": {
    "node": ">=18",
    "dsh": "^0.2.1-rc.5"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "cordis",
    "plugin",
    "heartbeat",
    "proactive",
    "agent"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LittleBlackTong/dsh-plugin-heartbeat.git"
  },
  "bugs": {
    "url": "https://github.com/LittleBlackTong/dsh-plugin-heartbeat/issues"
  },
  "homepage": "https://github.com/LittleBlackTong/dsh-plugin-heartbeat#readme"
}
